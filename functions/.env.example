# Copy to functions/.env before deploying. These are not secrets.
# The Resend API key is NOT here — it is set with:
#   firebase functions:secrets:set RESEND_API_KEY

# Who the email comes from. Must be on a domain verified in Resend.
# For a quick test before verifying DNS, use: onboarding@resend.dev
MAIL_FROM=Annual Physicals <physicals@blueangelclinical.com>

# Where the "Open the tracker" button points.
APP_URL=https://physicals.blueangelclinical.com
