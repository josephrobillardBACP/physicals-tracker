# Firebase project that holds the data and handles sign-in.
# These values are public by design: they identify the project, they do not
# grant access. Access is enforced by Firebase Auth plus firestore.rules.
#
# Reusing the existing travel medicine project means staff sign in exactly as
# they already do, with no new Google Cloud setup. Copy these from
# Firebase console > Project settings > Your apps > SDK setup and configuration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Only accounts on this Google Workspace domain may sign in.
VITE_ALLOWED_DOMAIN=blueangelclinical.com
