rules_version = '2';

// Security rules for the annual physicals data.
//
// IMPORTANT: if this project also hosts the travel medicine workflow, do NOT
// paste this file over the existing rules. Copy the helper functions (if they
// are not already there) and the `match /physicals/...` block into the existing
// `match /databases/{database}/documents { ... }` block, then publish.
//
// Nothing here is readable without a signed-in account on the clinic's
// Workspace domain, or an address an admin has added to admin/allowlist.

service cloud.firestore {
  match /databases/{database}/documents {

    function physicalsSignedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function physicalsEmail() {
      return request.auth.token.email.lower();
    }

    function physicalsOnDomain() {
      return physicalsEmail().matches('.*@blueangelclinical[.]com');
    }

    // Individual outside addresses granted access through the shared admin page.
    function physicalsOnAllowlist() {
      return exists(/databases/$(database)/documents/admin/allowlist)
        && get(/databases/$(database)/documents/admin/allowlist).data.emails[physicalsEmail()] != null;
    }

    function physicalsStaff() {
      return physicalsSignedIn() && (physicalsOnDomain() || physicalsOnAllowlist());
    }

    match /physicals/{panelId} {
      allow read, write: if physicalsStaff();

      // Patients, and the small doc the daily email job keeps its state in.
      match /{document=**} {
        allow read, write: if physicalsStaff();
      }
    }
  }
}
